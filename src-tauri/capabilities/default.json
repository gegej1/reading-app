{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults, the four knowledge-base commands, writing to the app log, and opening http(s) links in the default browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-kb-root",
    "allow-kb-list",
    "allow-kb-read",
    "allow-kb-write",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
