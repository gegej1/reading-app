{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults (including events), the knowledge-base commands, the AI runs (start, stop, check, discard, keep), showing the capture window, the tray counts and shortcut status, writing to the app log, and opening http(s) links in the default browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-kb-root",
    "allow-kb-list",
    "allow-kb-read",
    "allow-kb-read-head",
    "allow-kb-write",
    "allow-kb-create",
    "allow-kb-status",
    "allow-kb-sync",
    "allow-capture-show",
    "allow-tray-set-counts",
    "allow-desktop-info",
    "allow-run-start",
    "allow-run-cancel",
    "allow-run-status",
    "allow-run-steps",
    "allow-run-gate-input",
    "allow-run-gate-report",
    "allow-run-discard",
    "allow-run-keep",
    "allow-run-recheck",
    "allow-run-history",
    "allow-run-settings",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
