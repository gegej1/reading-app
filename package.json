{
  "name": "reading-app",
  "private": true,
  "version": "0.1.0",
  "description": "「底色」决策底色知识库的 Mac App 与网页版（只放代码，不含个人内容）",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vite",
    "dev:kb": "vite --mode kb",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "test": "vitest run",
    "test:kb": "vitest run src/domain/kb.realkb.test.ts",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/build-icon.mjs",
    "icon:tray": "node scripts/build-tray-icon.mjs",
    "tauri": "tauri",
    "guide": "DISE_UPDATE_GUIDE=1 vitest run src/export/guide.test.ts",
    "shortcuts": "node scripts/build-shortcuts.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
